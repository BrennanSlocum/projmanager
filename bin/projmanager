#!/usr/bin/env bash

# set -euo pipefail

VERSION=1.5
VERDATE="August 07, 2026"

readConfig() {
    PROJECT_CONFIG="$HOME/folders/projects/projmanager/bin/projects.json"

    IFS=$'\t' read -r PROJ_ROOT ARCHIVE PROJECTS LANGUAGE < <(
        jq -r '[.root, .archive, (.projects | join(" ")), .lang] | @tsv' "$PROJECT_CONFIG"
    )
}

projectExists() {
    readConfig
    jq -e --arg p "$1" '.projects[] | select(. == $p)' "$PROJECT_CONFIG" >/dev/null
}

requireProj() {
    local projName="$1"

    if ! projectExists "$projName"; then
        error "unknown project '$projName'"
    fi

    echo "$projName"
}

requireProjArg() {
    [[ $# -gt 0 ]] || error "unknown project '$1'"

    requireProj "$1"
}

# echo $PROJECTS

usage() {
    exitCode=${1:-0}
    printf "%b\n" "
${BOLD}projmanager${NC}

${BOLD}usage:${NC}
    projmanager [arguments]

${BOLD}arguments:${NC}
    -c --conf                       open config
    -g --gen        <PROJ-NAME>     generate new proj
    -h --help                       help
    -l --lint       <PROJ-NAME>     lint proj
    -o --open       <PROJ-NAME>     open project
    -p --push       <PROJ-NAME>     change project version (-U)
    -r --remove     <PROJ-NAME>     remove proj
    -u --update     <PROJ-NAME>     update project
    -v --version                    version of projmanager
    -x --execute    <PROJ-NAME>     eXecute proj
    -z --zip                        zip all in projects list
"
    exit "$exitCode"
}

ver() {
    printf "%b\n" "projmanager $BOLD$VERSION$NC ($VERDATE). used to manage personal projects."
    exit 0
}

# colors
FORMAT="\033["
ESC="m"

NC="${FORMAT}0$ESC"
BOLD="${FORMAT}1$ESC"
# DIM="${FORMAT}2$ESC"
# NORMAL="${FORMAT}22$ESC"

RED="${FORMAT}0;31$ESC"
YELLOW="${FORMAT}0;33$ESC"
GREEN="${FORMAT}0;32$ESC"
BLUE="${FORMAT}0;34$ESC"
MAGENTA="${FORMAT}0;35$ESC"
GRAY="${FORMAT}0;61$ESC"

WARN="${YELLOW}${BOLD}[WARN]${NC}"
ERROR="${RED}${BOLD}[ERROR]${NC}"
INFO="${BLUE}${BOLD}[INFO]${NC}"
PROMPT="${MAGENTA}${BOLD}[PROMPT]${NC}"
FIN="${GREEN}${BOLD}[FIN]${NC}"

info() {
    local msg=$1

    printf "%b\n" "${INFO} ${msg}"
}

prompt() {
    local msg=$1

    printf "%b" "${PROMPT} ${msg} "
}

warn() {
    local msg=$1

    printf "%b\n" "${WARN} ${msg}"
}

error() {
    local msg=$1
    local exitCode=${2:-1}

    printf "%b\n" "${ERROR} ${msg}; exiting..."
    exit "$exitCode"
}

fin() {
    printf "%b\n" "${FIN}"
    exit 0
}

open() {
    local projName="$1"
    ${EDITOR:-nano} "$projName"
    info "opened ${EDITOR:-nano}"
}

# options
zip=0
config=0
upd=""
proj=""
gen=""
delproj=""
exec=""
lint=""
push=0
import=""

# parse
while (($#)); do
    case "$1" in
        -h|--help)
            usage ;;
        -v|--version)
            ver ;;
        -z|--zip)
            zip=1 ;;
        -o|--open)
            shift; proj=$(requireProjArg "$1");;
        -u|--update)
            shift;
            if [[ "$1" == "*" ]]; then upd="*"; else upd=$(requireProjArg "$1"); fi;;
        -U|-p|--push)
            push=1
            shift;
            if [[ "$1" == "*" ]]; then upd="*"; else upd=$(requireProjArg "$1"); fi;;
        -r|--rm|--remove)
            shift; delproj=$(requireProjArg "$1");;
        -g|--gen|--generate)
            shift;
            if projectExists $1; then error "project $1 already exists"
            else gen="$1"; fi
            ;;
        -c|--config)
            config=1 ;;
        -x|--execute)
            shift; exec=$(requireProjArg "$1");;
        -l|--lint)
            shift; lint=$(requireProjArg "$1");;
        -i|--import)
            shift
            if [[ -e "$1" && "$1" == "projects.zip" ]]; then
                import="$1"
            else
                error "must import a 'projects.zip' file"
            fi;;
        *)
            error "unknown option $1"
    esac
    shift
done

# if they did nothing then do usage
if [[
    "$zip" -eq 0 &&
    "$config" -eq 0 &&
    -z "$upd" &&
    -z "$proj" &&
    -z "$gen" &&
    -z "$delproj" &&
    -z "$exec" &&
    -z "$lint" &&
    "$push" -eq 0 &&
    -z "$import"
]]; then error "needs atleast 1 argument"; usage; fi

# if -p but no -u
if [[
    "$push" -eq 1 &&
    -z "$upd"
]]; then error "-p needs a supplementary -u"; fi

_zip() {

    # make temp tozip
    tmpZip="${PROJ_ROOT}/.ziptmp"
    toZipDir="${tmpZip}/projects"
    mkdir -p "$toZipDir"
    info "made temporary folder at $toZipDir"

    prompt "include .git repo data? [y/N]"
    read -r choice < /dev/tty

    rsyncArgs=(-a)
    case "$choice" in
        y)
            :;;
        n|*)
            rsyncArgs+=(--exclude=".git");;
    esac
    # copy
    while IFS= read -r project; do
        # echo $project
        fullProjDir="$PROJ_ROOT/$project"

        if rsync ${rsyncArgs[@]} "$fullProjDir" "$toZipDir"; then
            info "copied ${GREEN}${project}${NC} to $toZipDir"
        else
            error "failed to copy over ${RED}${project}${NC} to $toZipDir" $?
        fi
    done < <(jq -r '.projects[]' "$PROJECT_CONFIG")
    info "done copying projects"
    # ls -a $toZipDir

    # make date file
    timestamp=$(date +"%B %d, %Y @ %H:%M:%S")
    echo "$timestamp" > "${toZipDir}/DATE.txt"
    info "made date file DATE.txt (${timestamp})"

    # ls -a $toZipDir

    (
        cd "$tmpZip"
        zip -r projects.zip ./* &>/dev/null
    )
    info "done zipping"

    # move to archive location
    (
        cd "$tmpZip"
        sudo mv "projects.zip" "$ARCHIVE"
    )
    info "moved to $ARCHIVE"

    zipFile="${ARCHIVE}/projects.zip"
    zipSizeB=$(du -sb "$zipFile" | cut -f1)
    tmpSizeB=$(du -sb "$tmpZip" | cut -f1)
    zipSize=$(du -sh "$zipFile" | cut -f1)
    tmpSize=$(du -sh "$tmpZip" | cut -f1)
    info "archive size is ${zipSize}iB"
    info "projects size is ${tmpSize}iB"
    info "~$(( zipSizeB * 100 / tmpSizeB ))% deflation"

    # rm temp
    rm -rf "$tmpZip"
    info "removed temporary folder $tmpZip"
}

proj() {

    local projName=$1

    projectDir="${PROJ_ROOT}/${projName}"
    # cd "$projectDir"
    # info "cd to $projectDir"
    open "$projectDir"
}

genproj() {

    local projName=$1

    newProjDir="${PROJ_ROOT}/${projName}"
    # exit if newProjDir alr exists
    if [[ -d $newProjDir ]]; then error "$newProjDir already exists"; fi

    # make bin
    mkdir -p "${newProjDir}/bin"
    echo "#!/usr/bin/env $LANGUAGE
set -euo pipefail

VER=\"0.0\"
VERDATE=\"$(date +%B %d, %Y)\"
" > "${newProjDir}/bin/${projName}"
    info "generated empty script"

    # make install
    echo "chmod +x ./$projName
sudo cp ./$projName /usr/local/bin" > "${newProjDir}/bin/install.sh"
    info "generated install script"

    # make readme
    echo "# $projName 0.0 by $USER" > "${newProjDir}/README.md"
    info "generated empty readme"

    # added to project list
    tmp=$(mktemp)
    jq --arg projName "$projName" '.projects += [$projName]' "$PROJECT_CONFIG" > "$tmp" && mv "$tmp" "$PROJECT_CONFIG"
    info "added $projName to projects.yaml"
}

rmproj() {

    local projName=$1
    prompt "are you sure you would like to delete project ${projName}? [y/N]"
    read -r choice

    # define delete
    projDir="${PROJ_ROOT}/${projName}"

    if [[ $choice == "y" ]]; then
        if [[ ! -d $projDir ]]; then error "missing project file $projDir"; fi

        rm -r "$projDir"
        warn "removed directory $projDir"

        tmp=$(mktemp)
        jq --arg projName "$projName" 'del(.projects[] | select(. == $projName))' "$PROJECT_CONFIG" > "$tmp" && mv "$tmp" "$PROJECT_CONFIG"
        info "removed $projName from projects.yaml"
    else
        info "did not receive 'y', exiting..."
        exit 0
    fi
}

updproj() {
    local projName="$1"
    projDir="${PROJ_ROOT}/${projName}/bin"
    projFile="${projDir}/${projName}" # /home/blue/folders/projects/projName/bin/projName
    readMe="${projDir}/../README.md"

    if [[ $push -eq 1 ]]; then
        info "looking for VERSION= and VERDATE="
        oldVer=$(grep '^VERSION=' "$projFile" | cut -d'=' -f2)
        info "old version is $oldVer"
        prompt "what should the new version be?"
        read -r \
        newVersion
        newVerDate=$(date +"%B %d, %Y")

        info "updating ${projName} to $newVersion..." # print special with newVer

        if [[ -z "$newVersion" ]]; then newVersion=${oldVer}; fi

        # echo $projFile

        prompt "save $projName before changing version:"
        read

        sed -i \
            -e "s/^VERSION=.*/VERSION=$newVersion/" \
            -e "s/^VERDATE=\"[^\"]*\"/VERDATE=\"$newVerDate\"/" \
            "$projFile"
        info "changed $oldVer to $newVersion ($newVerDate)"
        sed -i \
            "1c\\${projName} by ${USER}: ${newVersion} @ ${newVerDate}" \
            "$readMe"
        info "updated first line of ${projName}/README.md"
    else
        info "updating ${projName}..." # no special print
    fi

    cd "$projDir"
    if sudo install -m 755 "./$projName" "/usr/local/bin/$projName"; then
        info "${projName} updated"
    else
        error "install -m 755 on ${projName} failed..."
    fi
}

execproj() {

    local projName="$1"
    runExecutable="${PROJ_ROOT}/${projName}/bin/${projName}"

    # exit if it isnt an executable/doesnt exist
    if [[ ! -x "$runExecutable" ]]; then error "$runExecutable must be type executable"; fi

    # info "found $runExecutable"
    # sudo bash
    "${runExecutable}"
}

lintproj() {

    projName=$1

    projFile="${PROJ_ROOT}/${projName}/bin/${projName}"

    shellcheck "$projFile"
}

openconf() {

    [[ -n "$PROJECT_CONFIG" ]] || error "project config not found"

    info "found $PROJECT_CONFIG"
    open "$PROJECT_CONFIG"
}

_import() {
    readConfig
    local originalZip=$1

    # copy
    tmpZip="${PROJ_ROOT}/.imptmp"
    rm -rf "$tmpZip" >/dev/null # delete before creation so it starts cleanly
    mkdir -p "$tmpZip"
    info "made temporary directory in project root"
    rsync -a "$originalZip" "$tmpZip"
    info "copied $originalZip to $tmpZip"

    # unzip
    cd "$tmpZip"
    unzip "$originalZip" &>/dev/null
    info "unzipped $originalZip"
    rm -f "$originalZip"

    # ask to move
    find "${tmpZip}/projects" -mindepth 1 -maxdepth 1 -type d -print0 |
    while IFS= read -r -d '' impProject; do4

        # MOVE .imptmp/projects/impProject TO projects/impProject

        # echo $impProject
        # .imptmp/projects/projmanager
        baseDir=${impProject##*/} # .projmanager
        echo "$baseDir"
        projRootEquivalent="${PROJ_ROOT}/${baseDir}" # projects/projmanager
        echo "$projRootEquivalent"
        projRootBase="${projRootEquivalent##*/}"
        echo "$projRootBase"
        preSize="$(du -sh $projRootEquivalent | cut -f1)iB"
        impSize="$(du -sh $impProject | cut -f1)iB"

        projectRootBn="${PROJ_ROOT##*/}"

        if [[ ! "$choice" == "Y" ]]; then
            prompt "replace ${GRAY}.../${projRootBase}/${NC}$projRootBase ($preSize) with ${GRAY}.../${projRootBase}/${NC}$baseDir ($impSize)? [y/n]"
            read -r choice < /dev/tty
        fi

        if [[ "$choice" == "y" || "$choice" == "Y" ]]; then
            info "replacing ${baseDir}..."

            if rsync -a --delete  "$impProject/" "$projRootEquivalent/"; then
            info "replaced ${GREEN}successfully${NC}";
            else error "error during replacement of ${baseDir}"; fi
        else
            info "skipping ${baseDir}"
        fi
    done

    rm -rf "$tmpZip"
    info "removed tmpZip"
}

# handle proj generation
if [[ -n $gen ]]; then
    readConfig
    genproj "$gen"; fi

# handle project deletion
if [[ -n $delproj ]]; then
    readConfig
    rmproj "$delproj"; fi

# handle opening conf
if [[ $config -eq 1 ]]; then
    readConfig
    openconf; fi

# handle project updating
if [[ -n "$upd" ]]; then
    readConfig
    # if *, update all, otherwise update just 1

    if [[ "$upd" == "*" ]]; then
        for proj in $PROJECTS; do
            updproj "$proj"
        done
    else
        updproj "$upd"
    fi
    fin
fi

# can be paired together
# handle proj open
if [[ -n $proj ]]; then
    readConfig
    proj "$proj"; fi

# handle project execution
if [[ -n $exec ]]; then
    readConfig
    execproj "$exec"; fi

# handle project linting
if [[ -n $lint ]]; then
    readConfig
    lintproj "$lint"; fi

# handle zip
if [[ $zip -eq 1 ]]; then
    readConfig
    _zip; fi

if [[ -n "$import" ]]; then
    _import "$import"; fi

fin

# todo: add pm -i import
