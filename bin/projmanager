#!/usr/bin/env bash

set -euo pipefail

VERSION=1.6.2
VERDATE="August 13, 2026"

usage() {
    exitCode=${1:-0}
    printf "%b\n" "
${BOLD}projmanager${NC}

${BOLD}usage:${NC}
    projmanager [arguments]

${BOLD}arguments:${NC}
    -c --conf                       open config
    -g --gen        <PROJ-NAME>     generate new proj
    -h --help                       help
    -i --import                     import a -z archive
    -l --lint       <PROJ-NAME>     lint proj
    -o --open       <PROJ-NAME>     open project
    -r --remove     <PROJ-NAME>     remove proj
    -u --update     <PROJ-NAME>     update project
    -U --updpush    <PROJ-NAME>     update and change proj version
    -v --version                    version of projmanager
    -x --execute    <PROJ-NAME>     eXecute proj
    -z --zip                        zip all in projects list
"
    exit "$exitCode"
}

ver() {
    printf "%b\n" "projmanager $BOLD$VERSION$NC ($VERDATE). used to manage personal projects."
    exit 0
}

# colors
FORMAT="\033["
ESC="m"

NC="${FORMAT}0$ESC"
BOLD="${FORMAT}1$ESC"
# DIM="${FORMAT}2$ESC"
# NORMAL="${FORMAT}22$ESC"

RED="${FORMAT}0;31$ESC"
YELLOW="${FORMAT}0;33$ESC"
GREEN="${FORMAT}0;32$ESC"
BLUE="${FORMAT}0;34$ESC"
MAGENTA="${FORMAT}0;35$ESC"
# GRAY="${FORMAT}0;61$ESC"

WARN="${YELLOW}${BOLD}[WARN]${NC}"
ERROR="${RED}${BOLD}[ERROR]${NC}"
INFO="${BLUE}${BOLD}[INFO]${NC}"
PROMPT="${MAGENTA}${BOLD}[PROMPT]${NC}"
FIN="${GREEN}${BOLD}[FIN]${NC}"

GREENCHECK="[${GREEN}✓${NC}]"
REDX="[${RED}X${NC}]"

info() {
    local msg=$1
    printf "%b\n" "${INFO} ${msg}"
}

infoReplace() {
    local msg=$1
    printf "\033[1A\033[2K%b\n" "${INFO} ${msg}"
}

prompt() {
    local msg=$1

    printf "%b" "${PROMPT} ${msg} "
}

warn() {
    local msg=$1

    printf "%b\n" "${WARN} ${msg}"
}

error() {
    local msg=$1
    local exitCode=${2:-1}

    printf "%b\n" "${ERROR} ${msg}; exiting ($exitCode)..."
    exit "$exitCode"
}

fin() {
    printf "%b\n" "${FIN}"
    # exit 0
}

open() {
    local projName="$1"
    local editor
    editor="${EDITOR:-nano}"
    if "$editor" "$projName"; then
        info "opened ${editor}"
    else
        error "failed to open ${editor}"
    fi
}

readConfig() {
    PROJECT_CONFIG="$HOME/folders/projects/projmanager/bin/projects.json"

    [[ -f "$PROJECT_CONFIG" ]] || error "config not found: $PROJECT_CONFIG"

    # validate
    if ! jq -e '
        (.root | strings) and
        (.archive | strings) and
        (.lang | strings) and
        (.projects | type == "array") and
        (.projects | all(.[]; type == "string"))
    ' "$PROJECT_CONFIG" >/dev/null; then
        error "invalid project config: $config"
    fi

    # read
    IFS=$'\t' read -r PROJ_ROOT ARCHIVE LANGUAGE < <(
        jq -r '[.root, .archive, .lang] | @tsv' "$PROJECT_CONFIG"
    )

    # read project list
    mapfile -t PROJECTS < <(
        jq -r '.projects[]' "$PROJECT_CONFIG"
    )
}

projectExists() {
    readConfig
    jq -e --arg p "$1" '.projects[] | select(. == $p)' "$PROJECT_CONFIG" >/dev/null
}

requireProj() {
    local projName="$1"

    if ! projectExists "$projName"; then
        error "unknown project '$projName'"
    fi

    echo "$projName"
}

requireProjArg() {
    [[ $# -gt 0 ]] || error "unknown project '$1'"

    requireProj "$1"
}

# options
zip=0
config=0
upd=""
proj=""
gen=""
delproj=""
exec=""
lint=""
push=0
import=""

# parse
while (($#)); do
    case "$1" in
        -h|--help)
            usage ;;
        -v|--version)
            ver ;;
        -z|--zip)
            zip=1 ;;
        -o|--open)
            shift
            [[ $# -gt 0 ]] || error "-o|--open requires a project name"
            proj=$(requireProjArg "$1");;
        -u|--update)
            shift;
            [[ $# -gt 0 ]] || error "-u|--update requires a project name"
            if [[ "$1" == "*" ]]; then upd="*"; else upd=$(requireProjArg "$1"); fi;;
        -U|--updpush)
            push=1
            shift;
            [[ $# -gt 0 ]] || error "-U|--updpush requires a project name"
            if [[ "$1" == "*" ]]; then upd="*"; else upd=$(requireProjArg "$1"); fi;;
        -r|--rm|--remove)
            shift
            [[ $# -gt 0 ]] || error "-r|--rm|--remove requires a project name"
            delproj=$(requireProjArg "$1")
            echo "z";;
        -g|--gen|--generate)
            shift;
            [[ $# -gt 0 ]] || error "-g|--gen requires a project name"
            if projectExists "$1"; then error "project $1 already exists"
            else gen="$1"; fi
            ;;
        -c|--config)
            config=1 ;;
        -x|--execute)
            shift
            [[ $# -gt 0 ]] || error "-x|--execute requires a project name"
            exec=$(requireProjArg "$1");;
        -l|--lint)
            shift
            [[ $# -gt 0 ]] || error "-l|--lint requires a project name"
            lint=$(requireProjArg "$1");;
        -i|--import)
            readConfig
            projZip="$PROJ_ROOT/projects.zip"
            if [[ -e "$projZip" ]]; then
                info "found projects.zip"
                import="projects.zip"
            else
                error "projects.zip not found"
            fi;;
        *)
            error "unknown option $1"
    esac
    shift
done

if [[ "$zip" -eq 0 && "$config" -eq 0 && "$push" -eq 0 && \
    -z "$upd" && -z "$proj" && -z "$gen" && -z "$delproj" && \
    -z "$exec" && -z "$lint" && -z "$import" ]]; then
    info "no arguments found: use -h or --help for info"
fi

_zip() {
    # make temp tozip
    local tmpZip
    tmpZip="${PROJ_ROOT}/.ziptmp"

    toZipDir="${tmpZip}/projects"

    cleanupToZip() {
        rm -rf -- "$toZipDir"
    }

    [[ -d "$toZipDir" ]] && cleanupToZip

    if mkdir -p -- "$toZipDir"; then info "made temporary folder at $toZipDir"; trap cleanupToZip EXIT;
    else error "failed to make temporary folder at $toZipDir"; fi

    prompt "include .git repo data? [y/N]"
    read -r choice < /dev/tty

    local rsyncArgs
    rsyncArgs=(-a)
    case "$choice" in
        y)
            : ;;
        n|*)
            rsyncArgs+=(--exclude=".git");;
    esac
    # copy
    while IFS= read -r project; do
        # echo $project
        local fullProjDir
        fullProjDir="$PROJ_ROOT/$project"

        if rsync "${rsyncArgs[@]}" "$fullProjDir" "$toZipDir"; then
            info "copied ${GREEN}${project}${NC} to $toZipDir"
        else
            error "failed to copy over ${RED}${project}${NC} to $toZipDir" $?
        fi
    done < <(jq -r '.projects[]' "$PROJECT_CONFIG")
    info "done copying projects"
    # ls -a $toZipDir

    # sleep 1

    # make date file
    local timestamp
    timestamp=$(date +"%B %d, %Y @ %H:%M:%S")
    echo "$timestamp" > "${toZipDir}/DATE.txt"
    info "made date file DATE.txt (${timestamp})"

    # ls -a $toZipDir

    if (
        cd "$tmpZip" || exit 1
        zip -r projects.zip ./* &>/dev/null
    ); then
        info "done zipping"
    else
        error "failed to create archive"
    fi

    # measure deflation
    local zipFile
    zipFile="${tmpZip}/projects.zip"

    local zipSizeB
    local tmpSizeB
    local zipSize
    local projectsSizeB
    local projectsSize
    # local tmpSize
    zipSizeB=$(du -sb "$zipFile" | cut -f1) # byte size of archive
    tmpSizeB=$(du -sb "$tmpZip" | cut -f1) # byte size of projects + archive
    zipSize=$(du -sh "$zipFile" | cut -f1) # human readable size of archive
    # tmpSize=$(du -sh "$tmpZip" | cut -f1)
    projectsSizeB=$(( tmpSizeB - zipSizeB )) # (projects+archive) - archive
    projectsSize=$(numfmt --to=iec --format='%.0f' "$projectsSizeB") # human readable projectsSize
    info "archive size is ${zipSize}B"
    info "projects size is ${projectsSize}B"

    if (( projectsSizeB > 0 )); then
        info "$(( 100 - (zipSizeB * 100 / projectsSizeB) ))% deflation"
    else
        warn "empty projects"
    fi

    # tmpSizeB = (projects + zipSizeB)

    # move to archive location
    if (
        cd "$tmpZip" || exit
        mv "projects.zip" "$ARCHIVE"
    ); then
        info "moved to $ARCHIVE"
    else
        error "failed to move to $tmpZip"
    fi

    # rm temp
    if rm -rf "$tmpZip"; then
        info "removed temporary folder $tmpZip"
    else
        error "failed to remove temporary folder $tmpZip"
    fi
}

proj() {
    local projName=$1

    local projectDir
    projectDir="${PROJ_ROOT}/${projName}"

    # cd "$projectDir"
    # info "cd to $projectDir"
    open "$projectDir"
}

genproj() {
    local projName=$1

    # validate project name
    if projectExists "$projName"; then
        error "invalid project name $projName"
    fi

    local newProjDir
    newProjDir="${PROJ_ROOT}/${projName}"
    # exit if newProjDir alr exists
    if [[ -d $newProjDir ]]; then error "$newProjDir already exists"; fi

    # make bin
    mkdir -p "${newProjDir}/bin"
    echo "#!/usr/bin/env $LANGUAGE
set -euo pipefail

VERSION=0.0
VERDATE=\"$(date +"%B %d, %Y")\"
" > "${newProjDir}/bin/${projName}"
    info "generated empty script"

    # make install
    echo "#!/usr/bin/env $LANGUAGE
chmod +x ./$projName
install -m 755 ./$projName /usr/local/bin" > "${newProjDir}/bin/install.sh"
    info "generated install script"

    # make readme
    echo "# $projName 0.0 by $USER" > "${newProjDir}/README.md"
    info "generated empty readme"

    # added to project list
    local tmp
    tmp=$(mktemp)
    if jq --arg projName "$projName" \
    'del(.projects[] | select(. == $projName))' \
    "$PROJECT_CONFIG" \
    > "$tmp"; then
        mv "$tmp" "$PROJECT_CONFIG"
        info "added $projName to projects.json"
    else
        rm "$tmp"
        warn "failed to add $projName"
    fi
}

rmproj() {
    local projName=$1
    local choice

    prompt "are you sure you would like to delete project ${projName}? [y/N]"
    read -r choice

    # define delete
    local projDir
    projDir="${PROJ_ROOT}/${projName}"

    if [[ "$choice" == "y" ]]; then
        if [[ ! -d $projDir ]]; then error "missing project file $projDir"; fi

        rm -rf -- "$projDir"
        warn "removed directory $projDir"

        local tmp
        tmp=$(mktemp)
        jq --arg projName "$projName" 'del(.projects[] | select(. == $projName))' "$PROJECT_CONFIG" > "$tmp" && mv
"$tmp" "$PROJECT_CONFIG"
        info "removed $projName from projects.json"
    else
        info "did not receive 'y', exiting..."
        exit 0
    fi
}

updproj() {
    local projName="$1"
    local oldVer="${2:-}"

    local projDir
    local projFile
    local readMe

    projDir="${PROJ_ROOT}/${projName}/bin"
    projFile="${projDir}/${projName}" #/home/blue/folders/projects/projName/bin/projName
    readMe="${projDir}/../README.md"

    if [[ $push -eq 1 ]]; then
        # info "looking for VERSION= and VERDATE="
        info "selected project: $BOLD$projName${NC}"
        info "old version is ${oldVer}"
        prompt "what should the new version be?"
        local newVersion
        read -r \
        newVersion
        local newVerDate
        newVerDate=$(date +"%B %d, %Y")

        if [[ -z "$newVersion" ]]; then newVersion=${oldVer};
        info "skipping... (received no input)"; fi

        # echo $projFile

        if [[ "$newVersion" != "$oldVer" ]]; then
            prompt "save $projName before changing version:"
            read -r

            if [[ ! "$newVersion" =~ ^[0-9]+(\.[0-9]+)*([_-][0-9]+)?$ ]]; then error "invalid version '$newVersion'"; fi

            if sed -i \
                -e "1,10 s/^VERSION=.*/VERSION=$newVersion/" \
                -e "1,10 s/^VERDATE=\"[^\"]*\"/VERDATE=\"$newVerDate\"/" \
                "$projFile"; then
                info "changed $oldVer to $newVersion ($newVerDate)"
            else
                error "failed to change $oldVer to $newVersion ($newVerDate)"
            fi

            if sed -i \
                "1c\\${projName} by ${USER}: ${newVersion} @ ${newVerDate}" \
                "$readMe"; then
                info "updated first line of README.md"
            else
                error "failed to update README.md"
            fi
            prompt "open readme? [y/N]"
            local readMeOpen && read -r readMeOpen

            if [[ "$readMeOpen" == "y" ]]; then open "$readMe"; fi
            info "updating ${projName} to $newVersion..." # print special with newVer
        fi
    else
        info "updating ${projName}..." # no special print
    fi

    cd "$projDir" || error "failed to enter $projDir"
    if sudo install -m 755 "./$projName" "/usr/local/bin/$projName"; then
        infoReplace "${projName} updated ${GREENCHECK}"
    else
        error "install -m 755 on ${projName} failed... ${REDX}"
    fi
}

execproj() {
    local projName="$1"
    local runExecutable
    runExecutable="${PROJ_ROOT}/${projName}/bin/${projName}"

    # exit if it isnt an executable/doesnt exist
    if [[ ! -x "$runExecutable" ]]; then error "$runExecutable is not an executable"; fi

    # info "found $runExecutable"
    # bash
    "${runExecutable}"
}

lintproj() {
    local projName=$1
    local projFile && projFile="${PROJ_ROOT}/${projName}/bin/${projName}"

    shellcheck "$projFile"
}

openconf() {
    [[ -f "$PROJECT_CONFIG" ]] || error "project config not found"

    info "found $PROJECT_CONFIG"
    open "$PROJECT_CONFIG"
}

importproj() {
    readConfig

    local originalZip="$1"
    tmpImp="${PROJ_ROOT}/.imptmp"
    local choice=""

    # make temporary config file
    # if success, replace current config file with temp config file
    # otherwise, remove temp config
    importConfigTmp=$(mktemp) || error "failed to make a temporary config file"
    jq -e '.projects = []' "$PROJECT_CONFIG" > "$importConfigTmp" \
    || error "failed to write to a temporary config file"

    # for trap
    cleanupImport() {
        rm -rf -- "$tmpImp"
        rm -rf -- "$importConfigTmp"
    }

    # prepare tmp dir
    if [[ -d "$tmpImp" ]]; then
        info "removing old $tmpImp"
        rm -rf -- "$tmpImp"
    fi

    # make tmp dir
    if mkdir -p -- "$tmpImp"; then info "made temporary directory in project root" && trap cleanupImport EXIT;
    else error "failed to make temporary directory $tmpImp"; fi

    # copy archive into tmp dir
    rsync -a -- "$originalZip" "$tmpImp/"
    info "copied $originalZip to $tmpImp"

    # unzip archive
    cd "$tmpImp" || error "failed to enter $tmpImp"

    if unzip "$originalZip"; then
        info "unzipped $originalZip"
    else
        error "failed to unzip $originalZip"
    fi

    # compare/replace
    while IFS= read -r -d '' impProject; do
        local baseDir="${impProject##*/}"
        local projDir="${PROJ_ROOT}/${baseDir}"
        local projFile="${projDir}/bin/${baseDir}"
        local archiveFile="${impProject}/bin/${baseDir}"

        # exit early if these dont exist
        [[ -d "$impProject" && -e "$archiveFile" ]] || error "could not find one of these 2: $projFile $archiveFile"

        # initialize size variables
        local preSize
        local impSize
        local archiveVer
        local archiveVerDate
        local existingVer
        local existingVerDate

        preSize="$(du -sh "$projDir" | cut -f1)"
        impSize="$(du -sh "$impProject" | cut -f1)"

        archiveVer="$(grep -m1 '^VERSION=' "$archiveFile" | cut -d= -f2)"
        archiveVerDate="$(grep -m1 '^VERDATE=' "$archiveFile" | cut -d= -f2- | tr -d '"')"

        existingVer="$(grep -m1 '^VERSION=' "$projFile" | cut -d= -f2)"
        existingVerDate="$(grep -m1 '^VERDATE=' "$projFile" | cut -d= -f2)"

        # if choice == Y, skip prompt
        if [[ "$choice" != "Y" ]]; then
            prompt "existing: ${baseDir} ($preSize) [$existingVer on $existingVerDate]"
            prompt "archived: ${baseDir} ($impSize) [$archiveVer on $archiveVerDate] [Y/n]"
            read -r choice < /dev/tty
        fi

        # if choice == n|N, skip importing
        if [[ "$choice" =~ ^[Nn]$ ]]; then
            info "skipping $baseDir"
            continue
        fi

        # replace
        info "replacing $baseDir..."

        # added to project list
        local tmp
        tmp=$(mktemp)
        jq --arg projName "$baseDir" '.projects += [$projName]' "$importConfigTmp" > "$tmp" && mv "$tmp" "$importConfigTmp"
        info "added $projName to temporary config"

        if rsync -a --delete "$impProject/" "$projDir/"; then
            infoReplace "replaced $baseDir $GREENCHECK"
        else
            error "error during replacement of $baseDir $REDX"
        fi
    done < <(
        find "${tmpImp}/projects" \
            -mindepth 1 \
            -maxdepth 1 \
            -type d -print0
    )

    # rm tmp
    if rm -rf -- "$tmpImp"; then info "removed $tmpImp"
    else error "failed to remove $tmpImp"; fi

    # since it succeeded, move temporary config to new config
    mv "$importConfigTmp" "$PROJECT_CONFIG"
    readConfig
}

# handle proj generation
if [[ -n $gen ]]; then
    readConfig
    genproj "$gen"; fi

# handle project deletion
if [[ -n $delproj ]]; then
    readConfig
    rmproj "$delproj"; fi

# handle opening conf
if [[ $config -eq 1 ]]; then
    readConfig
    openconf; fi

# handle project updating
if [[ -n "$upd" ]]; then
    readConfig
    projDir="${PROJ_ROOT}/${upd}/bin"
    projFile="${projDir}/${upd}"
    oldVer=$(grep -m1 '^VERSION=' "$projFile" | cut -d'=' -f2)

    # if *, update all
    if [[ "$upd" == "*" ]]; then
        printf "\033[2J\033[H" # clear
        # do not double quote $PROJECTS
        for project in "${PROJECTS[@]}"; do
            projDir="${PROJ_ROOT}/${project}/bin"
            projFile="${projDir}/${project}"
            oldVer=$(grep -m1 '^VERSION=' "$projFile" | cut -d'=' -f2)

            # safety check for projfile not existing
            if [[ ! -f "$projFile" ]]; then
                printf "%b" "${WARN} project file not found: $projFile (continuing) " # not using warn cus newline is ugly
                read -r
                continue
            fi
            # safety check for oldver not being found
            if [[ -z "$oldVer" ]]; then
                warn "could not find version for ${project}."
                read -r
                continue
            fi

            # echo "$projDir"
            # echo "$projFile"
            # echo "$oldVer"

            if [[ "$push" -eq 1 ]]; then
                sleep 0.5
                printf "\033[2J\033[H"
            fi

            updproj "$project" "$oldVer"
        done
    else
        updproj "$upd" "$oldVer"
    fi
fi

# can be paired together
# handle proj open
if [[ -n $proj ]]; then
    readConfig
    proj "$proj"; fi

# handle project execution
if [[ -n $exec ]]; then
    readConfig
    execproj "$exec"; fi

# handle project linting
if [[ -n $lint ]]; then
    readConfig
    lintproj "$lint"; fi

# handle zip
if [[ $zip -eq 1 ]]; then
    readConfig
    _zip; fi

if [[ -n "$import" ]]; then
    importproj "$import"; fi

fin
